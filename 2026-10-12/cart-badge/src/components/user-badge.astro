---
import { getSession, type Session } from "../lib/session";

// "no-store" needs the hyphen: caches ignore unknown directives, so "nostore"
// would leave only "private" and let the browser cache keep the badge.
Astro.response.headers.set("Cache-Control", "private, no-store");

let session: Session | null = null;
let failed = false;
try {
  // getSession handles a missing sid, so logged-out users get the Sign in link too.
  session = await getSession(Astro.cookies.get("sid")?.value);
} catch {
  failed = true;
}
---

<span class="badge">
  {
    session ? (
      <span>
        {session.name} · <span role="img" aria-label="items in cart">🛒</span>{" "}
        {session.cartCount}
      </span>
    ) : failed ? (
      <a href="/account">Account</a>
    ) : (
      <a href="/sign-in">Sign in</a>
    )
  }
</span>
